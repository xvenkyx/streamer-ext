{
  "manifest_version": 3,
  "name": "Live Stream Assistant",
  "version": "3.0",
  "description": "Live-stream AI responses to client display. Alt+Shift+Z captures Meet captions.",

  "permissions": ["tabs", "scripting", "clipboardWrite", "clipboardRead", "storage"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "wss://relay.vhagar.online/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Meet Caption Assistant"
  },

  "commands": {
    "capture-caption": {
      "suggested_key": { "default": "Alt+Shift+Z" },
      "description": "Capture current Meet caption and send to AI"
    },
    "relay-manual": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Send clipboard content to relay (append)"
    },
    "relay-manual-replace": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Send clipboard content to relay (replace)"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"]
    },
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*"],
      "js": ["streamer.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src wss://relay.vhagar.online"
  }
}
